# Server Configuration
HOST=127.0.0.1
PORT=8787
ENVIRONMENT=development
# Base URL the server is reachable at (OAuth redirect URIs)
PUBLIC_URL=http://127.0.0.1:8787

# Bearer token every /v1 request must carry (required)
API_TOKEN=change-me

# Database Configuration (PostgreSQL). DATABASE_URL wins over DB_*.
# DATABASE_URL=postgres://localhost:5432/papermark?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=papermark
DB_PASSWORD=
DB_NAME=papermark
DB_SSLMODE=disable

# Redis Configuration. Optional for cmd/server (live events then stay in
# process), required for cmd/worker. REDIS_URL wins over REDIS_*.
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Agent
ANTHROPIC_API_KEY=
# Point at cmd/fakeanthropic to run without a key: http://127.0.0.1:8790
ANTHROPIC_BASE_URL=
AGENT_MODEL=claude-opus-5-5

# Task workspaces: WORKSPACE_DIR/<task id>. Server and worker must share it.
WORKSPACE_DIR=data/workspaces

# Job worker
WORKER_CONCURRENCY=16
WORKER_LEASE_SECONDS=30
WORKER_POLL_MS=1000

# Push (APNs token auth). Push is off unless all four are set.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# Connectors the app offers, both signed in with OAuth. GitHub's and Google's OAuth
# servers have no dynamic client registration, so each needs an OAuth client whose
# redirect URI is ${PUBLIC_URL}/v1/oauth/callback: a GitHub OAuth app, and a Google
# Cloud "Web application" client with the Gmail API enabled.
# *_SCOPES replace the broad scope lists the MCP servers advertise.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPES="repo read:org read:user user:email"
GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose"

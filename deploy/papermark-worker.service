# Papermark agent job worker (systemd unit)
# Install to /etc/systemd/system/papermark-worker.service
[Unit]
Description=Papermark agent job worker
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=papermark
Group=papermark
WorkingDirectory=/opt/papermark
EnvironmentFile=/etc/papermark/papermark.env
ExecStart=/opt/papermark/bin/worker
Restart=on-failure
RestartSec=5
# shell_exec children share the unit's cgroup; stop kills them too.
KillMode=control-group

# --- hardening ---
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

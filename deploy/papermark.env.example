# Server Configuration
HOST=0.0.0.0
PORT=8787
ENVIRONMENT=production
# Base URL the server is reachable at (OAuth redirect URIs)
PUBLIC_URL=http://127.0.0.1:8787

# Bearer token every /v1 request must carry (required)
API_TOKEN=change-me

# Database Configuration (PostgreSQL). DATABASE_URL wins over DB_*.
# DATABASE_URL=postgres://localhost:5432/papermark?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=papermark
DB_PASSWORD=
DB_NAME=papermark
DB_SSLMODE=disable

# Redis Configuration. Optional for cmd/server (live events then stay in
# process), required for cmd/worker. REDIS_URL wins over REDIS_*.
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Agent
ANTHROPIC_API_KEY=
# Point at cmd/fakeanthropic to run without a key: http://127.0.0.1:8790
ANTHROPIC_BASE_URL=
AGENT_MODEL=claude-opus-5-5

# Task workspaces: WORKSPACE_DIR/<task id>. Server and worker must share it.
WORKSPACE_DIR=/opt/papermark/data/workspaces

# Job worker
WORKER_CONCURRENCY=16
WORKER_LEASE_SECONDS=30
WORKER_POLL_MS=1000

# Push (APNs token auth). Push is off unless all four are set.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

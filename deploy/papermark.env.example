# Server Configuration
HOST=0.0.0.0
PORT=8787
ENVIRONMENT=production
# Base URL the server is reachable at (OAuth redirect URIs). Use the HTTPS
# domain in production; passkeys need it.
PUBLIC_URL=https://keen.example.com

# Sign-in. Google creates accounts; passkeys and Face ID are enrolled after.
# OAuth client ids whose Google ID tokens are accepted (comma list; add the iOS client id).
GOOGLE_CLIENT_IDS=
# Passkey relying party. RP_ID defaults to the PUBLIC_URL host and must be the
# HTTPS domain serving apple-app-site-association; ORIGINS defaults to PUBLIC_URL.
WEBAUTHN_RP_ID=keen.example.com
WEBAUTHN_RP_NAME=Keen
WEBAUTHN_ORIGINS=https://keen.example.com
# Session lifetime in hours (default 30 days)
SESSION_TTL_HOURS=720

# Database Configuration (PostgreSQL). DATABASE_URL wins over DB_*.
# DATABASE_URL=postgres://localhost:5432/papermark?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=papermark
DB_PASSWORD=
DB_NAME=papermark
DB_SSLMODE=disable

# Redis Configuration. Optional for cmd/server (live events then stay in
# process), required for cmd/worker. REDIS_URL wins over REDIS_*.
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Agent
# Tasks fail with a clear error while FIREWORKS_API_KEY is empty.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
AGENT_QUALITY_MODEL=accounts/fireworks/models/glm-5p3-flash
AGENT_SPEED_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
AGENT_MAX_TOKENS=16000
AGENT_MAX_STEPS=100
ROUTINE_MAX_STEPS=40
AGENT_CONTEXT_BUDGET=300000
AGENT_MODEL_TIMEOUT_SECONDS=120
AGENT_MODEL_MAX_RETRIES=2
# web_search is offered only when this is set.
TAVILY_API_KEY=

# Task workspaces: WORKSPACE_DIR/<task id>. Server and worker must share it.
WORKSPACE_DIR=/opt/papermark/data/workspaces

# Job worker
WORKER_CONCURRENCY=16
WORKER_LEASE_SECONDS=30
WORKER_POLL_MS=1000

# Push (APNs token auth). Push is off unless all four are set.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# Push via ntfy (free iOS app, no Apple developer account). Off unless NTFY_URL, NTFY_TOPIC and a
# secret are set. Each user's topic is <NTFY_TOPIC>-<12 hex of sha256(userID + secret)>; the secret is
# NTFY_TOPIC_SECRET, else TOKEN_ENCRYPTION_KEY.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOPIC_SECRET=
NTFY_TOKEN=

# Gmail connector (Gmail REST API; the hosted Gmail MCP and GMAIL_MCP_URL are no longer used).
# Users must reconnect Gmail once after the scopes change.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_SCOPES="https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/gmail.compose"
# Google Calendar connector (Calendar API v3). A separate sign-in from Gmail.
# The client defaults to GMAIL_CLIENT_ID/SECRET; enable the Calendar API in the same Google Cloud project.
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=
CALENDAR_SCOPES="https://www.googleapis.com/auth/calendar.events https://www.googleapis.com/auth/calendar.calendarlist.readonly"
# CALENDAR_API_URL=https://www.googleapis.com
# Google Contacts connector (People API, read-only, synced into Postgres every 3 hours). A separate sign-in.
# The client defaults to GMAIL_CLIENT_ID/SECRET; enable the People API in the same Google Cloud project.
CONTACTS_CLIENT_ID=
CONTACTS_CLIENT_SECRET=
CONTACTS_SCOPES="https://www.googleapis.com/auth/contacts.readonly https://www.googleapis.com/auth/contacts.other.readonly https://www.googleapis.com/auth/userinfo.email"
# CONTACTS_API_URL=https://people.googleapis.com
# Google Drive connector (Drive API v3, read-only). A separate sign-in.
# The client defaults to GMAIL_CLIENT_ID/SECRET; enable the Google Drive API in the same Google Cloud project.
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_SCOPES="https://www.googleapis.com/auth/drive.readonly"
# DRIVE_API_URL=https://www.googleapis.com

# Encrypts stored OAuth tokens (AES-256-GCM). 32 random bytes, base64: openssl rand -base64 32
# Unset keeps tokens in plaintext and the server logs a warning. Changing it forces reconnects.
TOKEN_ENCRYPTION_KEY=
